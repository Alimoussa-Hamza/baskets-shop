NODE_ENV=development
# En ligne uniquement : staging | production (active les garde-fous de src/lib/env-guards.ts)
APP_ENV=
DATABASE_URL=postgres://baskets:change-me-local@localhost:5432/baskets
# false = connexion sans SSL (réseau privé de l'hébergeur) ; SSL activé par défaut en production
DATABASE_SSL=
# production : ajouter ?sslmode=require
REDIS_URL=redis://localhost:6379
# shared (dev) | server | worker (staging, prod)
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=http://localhost:9000
# CORS restreint : origines exactes, pas de joker
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000
JWT_SECRET=generer-avec-openssl-rand-hex-32
COOKIE_SECRET=generer-avec-openssl-rand-hex-32
# Stripe : clés TEST en local/staging, LIVE seulement en production
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Fichiers S3/R2 (vide = stockage local en dev)
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
# Télémétrie Medusa désactivée (RGPD, moins de bruit réseau)
MEDUSA_DISABLE_TELEMETRY=1

# E-mails transactionnels (SMTP). Resend : smtp.resend.com:465, user "resend", pass = clé API. Brevo : smtp-relay.brevo.com:587.
# Sans SMTP_HOST, aucun e-mail n'est envoyé (avertissement dans les logs) : INTERDIT en production (accusé de rétractation légalement requis).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SHOP_NOTIFY_EMAIL=
SHOP_NAME=
SHOP_LEGAL_LINE=

# Dropshipping CJdropshipping (connecteur fournisseur). Sans clé : les commandes CJ restent « à passer » dans l admin.
# Commandes créées SANS paiement automatique (payType=3) : validation et paiement dans l espace CJ.
CJ_API_KEY=
# 1 = commandes créées en sandbox CJ (tests)
CJ_SANDBOX=1
# Import (admin « Import CJ ») : prix de vente TTC = coût de revient (achat + port CJ + douane) × coefficient,
# arrondi en …9 € ; taux USD → EUR des prix CJ ; droit de douane UE par article expédié hors UE (3 € depuis le 01/07/2026)
CJ_PRICE_COEF=2
CJ_USD_EUR=0.92
CUSTOMS_DUTY_EUR=3
# TVA à l'import pour les envois depuis la Chine : 3 = IOSS de CJ, 2 = votre numéro IOSS (CJ_IOSS_NUMBER). À valider avec le comptable.
CJ_IOSS_TYPE=3
CJ_IOSS_NUMBER=

# Cache catalogue de la boutique vidé à chaque modification produit (même valeur dans le .env de la boutique)
STOREFRONT_URL=http://localhost:8000
REVALIDATE_SECRET=
